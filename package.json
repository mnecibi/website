{
  "name": "website",
  "version": "1.0.0",
  "description": "my personal website",
  "main": "sketch.js",
  "scripts": {
    "start": "live-server",
    "dev": "npm run build:css && esbuild sketch.js --bundle --sourcemap --outfile=index.js --watch",
    "build": "npm run build:css && npm run build:js && node build-assets.mjs",
    "build:js": "esbuild sketch.js --bundle --minify --target=es2019 --outfile=index.js",
    "build:css": "tailwindcss -i input.css -o output.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mnecibi/website.git"
  },
  "keywords": [
    "p5.js",
    "accelerator",
    "js",
    "p5"
  ],
  "author": "mnecibi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mnecibi/website/issues"
  },
  "homepage": "https://github.com/mnecibi/website#readme",
  "dependencies": {
    "p5": "^1.11.3"
  },
  "devDependencies": {
    "@types/p5": "^1.7.6",
    "esbuild": "^0.25.0",
    "@tailwindcss/cli": "^4.0.17",
    "tailwindcss": "^4.0.17"
  }
}
